# --- Secrets ---------------------------------------------------------------
# Never commit a populated environment file. Only *.example is tracked.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- Node / frontend -------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Python / backend ------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
