# PharmaPanda frontend — development environment template.
#
# Copy to `.env` (or `.env.local`) at the repository root. Both are git-ignored.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so never
# put a secret here — everything in this file ships to the client.

# The FastAPI backend. Leave as-is to call the API directly (CORS already allows
# the Vite dev origin). Set to /api instead if you enable the Vite dev proxy.
VITE_API_BASE_URL=http://localhost:8000/api
