# PharmaPanda API — development environment template.
#
# Copy to `backend/.env` and adjust. `.env` is git-ignored.
# These values are development-only; supply real ones via the environment in
# every other deployment. Never commit a populated .env.

APP_NAME=PharmaPanda API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Mount point for all API routes.
API_PREFIX=/api

# Matches the `db` service in docker-compose.yml.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://pharmapanda:pharmapanda@localhost:5432/pharmapanda

# Vite dev server origin — allowed by CORS.
FRONTEND_URL=http://localhost:5173

# Optional extra allowed origins, comma-separated. Leave empty for local dev.
EXTRA_CORS_ORIGINS=

# --- Authentication ---------------------------------------------------------
# Signing key for JWT access tokens. The placeholder below is NOT a usable
# secret — generate your own before running anything but local development:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Staging and production refuse to start while this is left at the default.
JWT_SECRET_KEY=replace-me-with-a-generated-secret

JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (default: 12 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Minimum password length; matches the frontend's own validation.
MIN_PASSWORD_LENGTH=8
